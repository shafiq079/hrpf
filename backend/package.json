{
  "name": "hrpf-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/app.test.ts test/security.test.ts test/seed.test.ts",
    "check": "npm run typecheck && npm test && npm run seed:check && npm run seed:home && npm run build && npm run api:check",
    "setup": "node scripts/setup-env.mjs",
    "worker": "node dist/worker.js",
    "worker:dev": "node --watch --import tsx src/worker.ts",
    "db:indexes": "node --import tsx src/scripts/database.ts indexes",
    "admin:create": "node --import tsx src/scripts/database.ts admin",
    "test:integration": "node test/run-integration.mjs",
    "setup:security": "node scripts/setup-security.mjs",
    "api:generate": "node --import tsx src/scripts/openapi.ts",
    "api:check": "node --import tsx src/scripts/openapi.ts --check",
    "seed:check": "node --import tsx src/scripts/seed.ts check",
    "seed:plan": "node --import tsx src/scripts/seed.ts plan",
    "seed:prepare": "node --import tsx src/scripts/seed.ts prepare",
    "seed:import": "node --import tsx src/scripts/seed.ts import",
    "test:seed": "node --import tsx --test test/seed.integration.test.ts test/homepage-seed.integration.test.ts",
    "seed:home": "node --import tsx src/scripts/seed-homepage.ts"
  },
  "dependencies": {
    "bullmq": "6.3.11",
    "busboy": "1.6.0",
    "cloudinary": "2.11.0",
    "cors": "2.8.6",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "mongoose": "9.10.4",
    "nodemailer": "10.0.15",
    "redis": "6.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
