# No credentials here. Keep actual values in backend/.env or Codespaces secrets.
# Environment variables override this file.
NODE_ENV=development
PORT=5000
# Empty: localhost plus this Codespace's exact port-3000 origin in development.
FRONTEND_URL=
# Optional comma-separated additional exact HTTP(S) origins; no wildcard.
CORS_ORIGINS=
# Inside the rebuilt devcontainer. For host Redis: redis://127.0.0.1:6379.
REDIS_URL=redis://redis:6379
MONGODB_URI=
MONGODB_DB_NAME=hrpf_dev
# Configure privately for M2 features. Blank optional services remain unavailable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# smtp for existing development; resend uses HTTPS and works on Render free.
EMAIL_PROVIDER=smtp
# worker: separate process; embedded: API handles its Mongo outbox while awake.
EMAIL_DELIVERY_MODE=worker
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Required for complaint intake: comma-separated addresses receiving the complete form and private file copies.
ADMIN_NOTIFY_EMAILS=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# M2 security keys: npm run setup:security generates missing values privately.
# 64 hex characters (32 bytes); protect/back up this key before real submissions.
DATA_ENCRYPTION_KEY=
# Separate keyed CNIC lookup hash, at least 43 characters.
CNIC_HASH_KEY=
# Explicit trusted proxy IPs/CIDRs, comma-separated. Blank ignores forwarded IPs.
# Configure only after verifying the deployment's proxy chain; never use true.
TRUST_PROXY_CIDRS=
# Separate Cloudinary folders. Production must set hrpf/prod.
CLOUDINARY_NAMESPACE=hrpf/dev
# No bypass in development. Exact hostnames and action=complaint/membership/contact.
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
# SMTP 465: true; SMTP 587: false (STARTTLS is required).
SMTP_SECURE=false

# Public JSON cache lifetime; transactional revisions invalidate edits immediately.
PUBLIC_CACHE_TTL_SECONDS=300
