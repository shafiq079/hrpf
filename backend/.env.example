# No credentials here. Keep actual values in backend/.env or Codespaces secrets.
# Environment variables override this file.
NODE_ENV=development
PORT=5000
# Empty: localhost plus this Codespace's exact port-3000 origin in development.
FRONTEND_URL=
# Optional comma-separated additional exact HTTP(S) origins; no wildcard.
CORS_ORIGINS=
# Inside the rebuilt devcontainer. For host Redis: redis://127.0.0.1:6379.
REDIS_URL=redis://redis:6379
MONGODB_URI=
MONGODB_DB_NAME=hrpf_dev
# Not consumed in M1; configure privately when those modules are implemented.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_NOTIFY_EMAILS=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
