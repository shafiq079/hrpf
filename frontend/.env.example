# Server-only API origin. Local development uses the independently started backend.
INTERNAL_API_URL=http://127.0.0.1:5000
# On Vercel, set INTERNAL_API_URL to the Render HTTPS service origin (no /api path).
# Restart Next.js after changing this value; deployed rewrites require a rebuild.

# Public Turnstile widget site key for File a Complaint; rebuild/restart after changes.
# Configure matching TURNSTILE_SECRET_KEY and exact TURNSTILE_HOSTNAMES in backend.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
